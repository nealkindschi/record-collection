---
import BaseLayout from "../layouts/BaseLayout.astro";
import CollectionApp from "../components/CollectionApp";
import SearchBar from "../components/SearchBar";
import { searchReleases } from "../utils/db";

const db = Astro.locals.runtime.env.DB;
const { results: initialResults, total: initialTotal } = await searchReleases(db, { limit: 25, offset: 0 });
---

<BaseLayout title="Record Collection">
  <header
    id="site-header"
    class="sticky top-0 z-30 border-b border-transparent transition-[background-color,border-color,box-shadow] duration-300 data-[scrolled]:bg-crate-950/85 data-[scrolled]:backdrop-blur-md data-[scrolled]:border-crate-600/50 data-[scrolled]:shadow-lg data-[scrolled]:shadow-black/30"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-5 flex items-center justify-between gap-4 sm:gap-6">
      <div>
        <h1 class="font-display text-3xl sm:text-5xl tracking-wide text-white leading-none">Whichwax</h1>
        <p class="hidden sm:block text-wax-400 text-sm mt-0.5 font-body">Search and browse your collection</p>
      </div>
      <div class="flex-1 min-w-0 max-w-sm sm:max-w-md lg:max-w-lg">
        <SearchBar client:load query="" />
      </div>
    </div>
  </header>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-6 sm:pt-6 sm:pb-10">
    <CollectionApp client:load initialResults={initialResults} initialTotal={initialTotal} />
  </div>
  <script is:inline>
    (() => {
      const header = document.getElementById("site-header");
      const root = document.documentElement;
      const setHeight = () => root.style.setProperty("--header-h", `${header.offsetHeight}px`);
      new ResizeObserver(setHeight).observe(header);
      setHeight();
      const onScroll = () => header.toggleAttribute("data-scrolled", window.scrollY > 4);
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    })();
  </script>
</BaseLayout>
